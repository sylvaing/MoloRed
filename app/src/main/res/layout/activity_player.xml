<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView android:id="@+id/player_view"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:focusable="false"/>

    <TextView android:id="@+id/digits" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_gravity="top|end"
        android:layout_margin="40dp" android:textColor="@color/text" android:textSize="64sp"
        android:textStyle="bold" android:shadowColor="#000000" android:shadowRadius="8"
        android:visibility="gone"/>

    <TextView android:id="@+id/message" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_gravity="center"
        android:background="@color/overlay" android:padding="20dp"
        android:textColor="@color/text" android:textSize="22sp" android:visibility="gone"/>

    <!-- Time-shift chip: "−12 min" while delayed -->
    <TextView android:id="@+id/ts_chip" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_gravity="top|start"
        android:layout_margin="36dp" android:background="@drawable/chip_bg"
        android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="6dp" android:paddingBottom="6dp"
        android:textColor="@color/text" android:textSize="18sp" android:textStyle="bold"
        android:visibility="gone"/>

    <!-- Control panel (Up): channel + programme, live button, time-shift scrub bar -->
    <LinearLayout android:id="@+id/ts_overlay" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_gravity="bottom"
        android:background="@drawable/overlay_bg" android:orientation="vertical"
        android:paddingStart="56dp" android:paddingEnd="56dp" android:paddingTop="90dp"
        android:paddingBottom="36dp" android:visibility="gone">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <ImageView android:id="@+id/p_logo" android:layout_width="120dp" android:layout_height="84dp"
                android:scaleType="fitCenter" android:layout_marginEnd="24dp"/>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
                    <TextView android:id="@+id/p_number" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="@color/accent"
                        android:textSize="26sp" android:textStyle="bold" android:layout_marginEnd="14dp"/>
                    <TextView android:id="@+id/p_name" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="@color/text"
                        android:textSize="26sp" android:textStyle="bold"/>
                </LinearLayout>
                <TextView android:id="@+id/ts_title" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textColor="@color/text"
                    android:textSize="21sp" android:maxLines="1" android:ellipsize="end"/>
                <TextView android:id="@+id/p_next" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textColor="@color/text_dim"
                    android:textSize="17sp" android:maxLines="1" android:ellipsize="end"/>
            </LinearLayout>
            <TextView android:id="@+id/ts_tracks_btn" android:layout_width="wrap_content"
                android:layout_height="52dp" android:gravity="center" android:layout_marginEnd="14dp"
                android:paddingStart="20dp" android:paddingEnd="20dp"
                android:text="@string/tracks_button" android:textColor="@color/text"
                android:textSize="18sp" android:textStyle="bold"/>
            <TextView android:id="@+id/ts_live_btn" android:layout_width="wrap_content"
                android:layout_height="52dp" android:gravity="center"
                android:paddingStart="22dp" android:paddingEnd="22dp"
                android:text="@string/ts_live_button" android:textColor="@color/text"
                android:textSize="18sp" android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/ts_bar_row" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="22dp"
            android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="10dp"
            android:paddingTop="8dp" android:paddingBottom="8dp">
            <TextView android:id="@+id/ts_state" android:layout_width="44dp"
                android:layout_height="wrap_content" android:gravity="center"
                android:textColor="@color/text" android:textSize="26sp"/>
            <SeekBar android:id="@+id/ts_progress" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:max="1000"
                android:focusable="false" android:clickable="false"
                android:progressTint="@color/accent" android:secondaryProgressTint="#99FFFFFF"
                android:progressBackgroundTint="#44FFFFFF" android:thumbTint="@color/text"/>
            <TextView android:id="@+id/ts_offset" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginStart="12dp"
                android:background="@drawable/chip_bg"
                android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="4dp" android:paddingBottom="4dp"
                android:textColor="@color/text" android:textSize="18sp" android:textStyle="bold"/>
        </LinearLayout>

        <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:paddingStart="54dp" android:paddingEnd="10dp">
            <TextView android:id="@+id/ts_start" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_gravity="start"
                android:textColor="@color/text_dim" android:textSize="16sp"/>
            <TextView android:id="@+id/ts_hint" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_gravity="center_horizontal"
                android:textColor="@color/text_dim" android:textSize="15sp"/>
            <TextView android:id="@+id/ts_end" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_gravity="end"
                android:layout_marginEnd="110dp"
                android:textColor="@color/text_dim" android:textSize="16sp"/>
        </FrameLayout>
    </LinearLayout>

    <LinearLayout android:id="@+id/strip" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_gravity="bottom"
        android:background="@drawable/overlay_bg" android:orientation="vertical"
        android:paddingTop="80dp" android:paddingBottom="24dp" android:visibility="gone">
        <TextView android:id="@+id/strip_title" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:paddingStart="56dp" android:paddingEnd="56dp"
            android:textColor="@color/text" android:textSize="22sp" android:textStyle="bold"
            android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/strip_next" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:paddingStart="56dp" android:paddingEnd="56dp"
            android:layout_marginBottom="6dp" android:textColor="@color/text_dim" android:textSize="17sp"
            android:maxLines="1" android:ellipsize="end"/>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/strip_list"
            android:layout_width="match_parent" android:layout_height="210dp"
            android:clipToPadding="false" android:clipChildren="false"
            android:paddingStart="48dp" android:paddingEnd="48dp" android:paddingTop="12dp"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/banner" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_gravity="bottom"
        android:background="@drawable/overlay_bg" android:orientation="horizontal"
        android:gravity="center_vertical" android:paddingStart="48dp" android:paddingEnd="48dp"
        android:paddingTop="60dp" android:paddingBottom="36dp">
        <ImageView android:id="@+id/b_logo" android:layout_width="140dp" android:layout_height="100dp"
            android:scaleType="fitCenter" android:layout_marginEnd="28dp"/>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
                <TextView android:id="@+id/b_number" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textColor="@color/accent"
                    android:textSize="30sp" android:textStyle="bold" android:layout_marginEnd="16dp"/>
                <TextView android:id="@+id/b_name" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textColor="@color/text"
                    android:textSize="30sp" android:textStyle="bold"/>
            </LinearLayout>
            <TextView android:id="@+id/b_now" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="@color/text"
                android:textSize="22sp" android:maxLines="1" android:ellipsize="end"/>
            <ProgressBar android:id="@+id/b_progress" style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent" android:layout_height="6dp"
                android:layout_marginTop="8dp" android:layout_marginBottom="8dp"
                android:max="100" android:progressTint="@color/accent"/>
            <TextView android:id="@+id/b_next" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="@color/text_dim"
                android:textSize="18sp" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
